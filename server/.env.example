# Copy to .env and adjust. Never commit the real .env.

# Port the HTTP + WebSocket server listens on
PORT=4000

# Secret used to sign JWTs. Use a long random string outside local dev.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file (use ":memory:" for an ephemeral in-memory DB)
DB_FILE=devspace.db

# Allowed CORS origin for the REST API and WebSocket handshake ("*" for local dev)
CORS_ORIGIN=*

# Optional: path to a prebuilt client to serve from this same service
# CLIENT_DIST=../client/dist
